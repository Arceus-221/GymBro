# gymbro-backend/.env.example
# Copy this file to .env and fill in real values. NEVER commit the real .env file.

PORT=3000

# ── Firebase Admin SDK (Service Account) ────────────────────────────────────
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=gymbro-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@gymbro-xxxxx.iam.gserviceaccount.com
# IMPORTANT: keep \n as literal characters in this string — config/firebase.js
# converts them back to real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# ── AI Provider Selection (Phase 5 §3) ───────────────────────────────────────
# One env var swaps the entire AI backend. No controller code changes required.
AI_PROVIDER=gemini
# AI_PROVIDER=openrouter

# ── Gemini (default provider) ────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ── OpenRouter (only required if AI_PROVIDER=openrouter) ────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# ── Groq-hosted Whisper (audio transcription proxy, Phase 4 §4) ────────────
GROQ_API_KEY=gsk_...

# ── Misc ──────────────────────────────────────────────────────────────────
NODE_ENV=development
